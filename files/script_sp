#!/bin/bash

# Start DOSBox independently so the GOG launcher can close immediately.
LOG_DIR="$HOME/Library/Logs/Dungeon Keeper Gold"
mkdir -p "$LOG_DIR"
nohup /opt/homebrew/bin/dosbox \
    --noprimaryconf \
    --nolocalconf \
    --conf game/dosboxDK.conf \
    --conf game/dosboxDK_staging.conf \
    --conf game/dosboxDK_single.conf \
    >"$LOG_DIR/singleplayer.log" 2>&1 &
exit 0
